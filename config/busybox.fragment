# KickflipOS BusyBox options, applied on top of `make defconfig`.

# One self-contained binary, no shared libraries needed
CONFIG_STATIC=y
# tc doesn't build against kernel headers 6.8+, and we don't need it
# CONFIG_TC is not set

# Things KickflipOS relies on
CONFIG_SETFONT=y
CONFIG_FEATURE_LOADFONT_PSF2=y
CONFIG_MKE2FS=y
CONFIG_BLKID=y
CONFIG_CTTYHACK=y
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
