#!/bin/sh
# Street Session - a KickflipOS game
E=$(printf '\033')
Y="$E[1;33m"; R="$E[1;31m"; G="$E[1;32m"; C="$E[1;36m"; P="$E[1;35m"; B="$E[1m"; N="$E[0m"
HS=/root/.skate_highscore
best=$(cat $HS 2>/dev/null || echo 0)

pick() { awk -v r=$RANDOM 'BEGIN{srand(r)} {a[NR]=$0} END{print a[int(rand()*NR)+1]}'; }

clear
printf "${Y}"
cat << 'ART'

     ____  _                 _     ____                _
    / ___|| |_ _ __ ___  ___| |_  / ___|  ___  ___ ___(_) ___  _ __
    \___ \| __| '__/ _ \/ _ \ __| \___ \ / _ \/ __/ __| |/ _ \| '_ \
     ___) | |_| | |  __/  __/ |_   ___) |  __/\__ \__ \ | (_) | | | |
    |____/ \__|_|  \___|\___|\__| |____/ \___||___/___/_|\___/|_| |_|

ART
printf "${N}   3 runs. Chain tricks. Bail and you lose the run.  High score: ${C}$best${N}\n\n"
printf "   Press any key to drop in..."
read -n 1 -s k

total=0
run=1
while [ $run -le 3 ]; do
  spot=$(printf '%s\n' "parking lot curb|1" "hubba ledge|2" "school handrail|3" \
         "downtown 10-stair|3" "backyard pool|2" "loading dock gap|2" "DIY spot under the bridge|2" | pick)
  name=${spot%|*}; mult=${spot#*|}
  combo=0; count=0; bailed=0; msg="You roll up. Pick your first trick."

  while :; do
    clear
    printf "\n  ${Y}RUN $run/3${N}  -  ${B}$name${N}  ${P}(x$mult)${N}\n"
    printf "\n  %s\n" "$msg"
    printf "\n  Combo: ${G}$combo${N} pts, $count tricks    Total: ${C}$total${N}\n\n"
    printf "   ${B}1${N}) ollie         100\n"
    printf "   ${B}2${N}) kickflip      200\n"
    printf "   ${B}3${N}) 50-50 grind   300\n"
    printf "   ${B}4${N}) 360 flip      500\n"
    printf "   ${B}5${N}) impossible    800  ${R}gnarly${N}\n"
    printf "   ${B}r${N}) roll away and bank it\n\n  > "
    read -n 1 k; echo
    case $k in
      1) t="ollie";       p=100; ch=95 ;;
      2) t="kickflip";    p=200; ch=85 ;;
      3) t="50-50 grind"; p=300; ch=75 ;;
      4) t="360 flip";    p=500; ch=60 ;;
      5) t="impossible";  p=800; ch=45 ;;
      r|R) break ;;
      *) continue ;;
    esac
    ch=$((ch - count * 7)); [ $ch -lt 10 ] && ch=10
    printf "\n  Going for a ${B}%s${N} (%d%% chance)" "$t" $ch
    for i in 1 2 3; do sleep 0.3; printf "."; done
    if [ $((RANDOM % 100)) -lt $ch ]; then
      combo=$((combo + p)); count=$((count + 1))
      printf " ${G}LANDED!${N}\n"
      msg="${G}Landed the $t!${N} Keep going, or roll away to bank it."
      sleep 0.8
    else
      printf " ${R}BAILED! *CRUNCH*${N}\n"
      bailed=1; break
    fi
  done

  if [ $bailed -eq 1 ]; then
    quip=$(printf '%s\n' "Ollie: Brooo. That was a slam. Shake it off." \
           "Ollie: Your board went one way, you went the other." \
           "Ollie: Gravity filed a bug report on you." \
           "Ollie: A security guard saw that. Awkward." | pick)
    printf "\n  Run lost.  ${Y}$quip${N}\n"
  else
    score=$((combo * count * mult))
    total=$((total + score))
    printf "\n  ${G}Banked!${N} $combo x $count tricks x $mult = ${C}$score${N}\n"
  fi
  run=$((run + 1))
  printf "\n  Press any key..."; read -n 1 -s k
done

if   [ $total -lt 1000 ];  then rank="Kook"
elif [ $total -lt 5000 ];  then rank="Grom"
elif [ $total -lt 15000 ]; then rank="Local Ripper"
elif [ $total -lt 40000 ]; then rank="Sponsored"
elif [ $total -lt 80000 ]; then rank="Pro"
else rank="LEGEND"
fi

clear
printf "\n  ${Y}SESSION OVER${N}\n\n  Final score: ${C}$total${N}\n  Rank: ${P}$rank${N}\n\n"
if [ $total -gt $best ]; then
  echo $total > $HS
  printf "  ${G}NEW HIGH SCORE!${N} Ollie is losing their mind.\n\n"
else
  printf "  High score to beat: $best\n\n"
fi
