#!/bin/busybox sh
# KickflipOS - the first program the kernel runs
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
hostname kickflip
export HOME=/root
/usr/bin/setfont -C /dev/tty0 /usr/share/consolefonts/kickflip.psf 2>/dev/null
skatecolors
clear

ok() { printf "  \033[1;33m[ RAD ]\033[0m %s\n" "$1"; sleep 0.3; }
printf "\n\033[1;31mKickflipOS is rolling in...\033[0m\n\n"
ok "Tightening trucks"
ok "Spinning bearings (ABEC-7)"
ok "Gripping deck"
ok "Waxing the curb"
ok "Checking for security guards"
printf "  \033[1;32m[ GO! ]\033[0m Dropping in\n"
sleep 0.7
clear
cd /root
exec setsid cttyhack sh -l
